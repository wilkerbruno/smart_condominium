# Copie este arquivo para ".env" (nunca commite o .env de verdade!)
# e no EasyPanel cadastre as mesmas chaves em "Environment".

# ── Segurança — gere valores aleatórios únicos, nunca reutilize ──
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-aleatoria-de-64-caracteres
JWT_SECRET_KEY=troque-por-outra-chave-aleatoria-diferente-da-de-cima

# ── Banco de dados MySQL ──────────────────────────────────────────
DB_HOST=easypanel.pontocomdesconto.com.br
DB_PORT=3309
DB_USER=mysql
DB_PASSWORD=troque-esta-senha-agora-ela-vazou-no-github
DB_NAME=smart_condominium

# ── CORS — origens autorizadas a chamar a API (app mobile/web) ───
# Em dev, o Expo roda em algo como http://192.168.0.10:8081
# Em produção, use o domínio real do app/site, nunca "*"
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

FLASK_ENV=production
